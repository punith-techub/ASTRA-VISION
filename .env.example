# =====================================================================
# ASTRA VISION - Environment Variables & API Keys Configuration
# =====================================================================
# Copy this file to .env:
#   copy .env.example .env     (Windows PowerShell / CMD)
#   cp .env.example .env       (Linux / macOS)
#
# IMPORTANT:
#   1. NEVER commit your actual .env file to Git or push it to GitHub!
#   2. .env is already included in .gitignore to prevent accidental exposure.
#   3. ASTRA VISION runs 100% offline out-of-the-box even without any API keys.
#   4. Adding keys enables multi-cloud tactical verification & online self-learning.
# =====================================================================

# Google Gemini API Key (Highly Recommended - Free tier available)
# Get your key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq Cloud API Key (Highly Recommended - Ultra-fast inference, Free tier available)
# Get your key here: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API Key (Optional Fallback)
# Get your key here: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local Ollama Server URL (Optional - For local offline LLM fallback)
OLLAMA_URL=http://localhost:11434
